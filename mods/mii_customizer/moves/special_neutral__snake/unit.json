  "status_id_note": "STATUS_BASE = 0x1FA = FIGHTER_MIIGUNNER_STATUS_KIND_NUM; one constant in unit.rs. No other unit allocated Gunner status ids when this was written; renumber the constant if one does.",
  "line_callback": "on_line(Main) watch_grenades on the miigunner agent (idle unless this entry pulled a grenade)",
  "native_hook": {
    "function": "app::snakegrenade::life() main+0x1674e90 (13.0.4)",
    "installed": "lazily, the first time a Gunner takes the move; only if the six instruction words are the originals; skipped when the function is already hooked (the other mod's bridge)",
    "acts": "returns 150 only inside this unit's have_item call and only when Snake's parameter chain is unreadable; every other call runs the original"
  },
  "effects": {
    "all": "sys_smash_flash, sys_run_smoke, sys_down_smoke, sys_jump_aerial (common bank); no effect bank is touched. The explosion effects are the item's own."
  },
  "sounds": {
    "se_snake_special_N01": "Snake tone appended unchanged to se_miigunner and se_miigunner_c00",
    "se_snake_special_N02": "Snake tone appended unchanged to se_miigunner and se_miigunner_c00",
    "se_snake_special_N03": "Snake tone appended unchanged to se_miigunner and se_miigunner_c00",
